{
  "name": "dsh-quberi",
  "description": "Search your Quberi knowledge base from DeepSeek Harness (OAuth sign-in, read-only)",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/quberi/dsh-quberi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quberi/dsh-quberi.git"
  },
  "bugs": {
    "url": "https://github.com/quberi/dsh-quberi/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "quberi",
    "knowledge-base",
    "rag",
    "oauth"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
